{
  "diagram_type": "sequence",
  "title": "导出请求的同步受理与异步执行",
  "subtitle": "示意模型 · 以图型语义表达业务逻辑",
  "nodes": [
    {
      "id": "client",
      "label": "客户端",
      "kind": "action",
      "role": "blue"
    },
    {
      "id": "api",
      "label": "导出接口",
      "kind": "action",
      "role": "teal"
    },
    {
      "id": "auth",
      "label": "权限服务",
      "kind": "action",
      "role": "purple"
    },
    {
      "id": "store",
      "label": "导出记录库",
      "kind": "action",
      "role": "slate"
    },
    {
      "id": "queue",
      "label": "任务队列",
      "kind": "action",
      "role": "orange"
    },
    {
      "id": "worker",
      "label": "导出执行器",
      "kind": "action",
      "role": "green"
    }
  ],
  "edges": [
    {
      "id": "m1",
      "source": "client",
      "target": "api",
      "label": "请求导出",
      "kind": "sync"
    },
    {
      "id": "m2",
      "source": "api",
      "target": "auth",
      "label": "检查访问权限",
      "kind": "sync"
    },
    {
      "id": "m3",
      "source": "auth",
      "target": "api",
      "label": "权限判定",
      "kind": "return"
    },
    {
      "id": "m8",
      "source": "api",
      "target": "store",
      "label": "保存导出记录",
      "kind": "sync"
    },
    {
      "id": "m9",
      "source": "store",
      "target": "api",
      "label": "记录已持久化",
      "kind": "return"
    },
    {
      "id": "m4",
      "source": "api",
      "target": "queue",
      "label": "提交导出任务",
      "kind": "async"
    },
    {
      "id": "m5",
      "source": "api",
      "target": "client",
      "label": "已受理与任务号",
      "kind": "return"
    },
    {
      "id": "m6",
      "source": "queue",
      "target": "worker",
      "label": "投递任务",
      "kind": "async"
    },
    {
      "id": "m7",
      "source": "api",
      "target": "client",
      "label": "拒绝无权访问",
      "kind": "return"
    }
  ],
  "branches": [
    {
      "kind": "alt",
      "operands": [
        {
          "guard": "[权限允许]",
          "start": "m8",
          "end": "m6"
        },
        {
          "guard": "[权限拒绝]",
          "start": "m7",
          "end": "m7"
        }
      ]
    }
  ],
  "activations": [
    {
      "participant": "api",
      "start": "m1",
      "end": "m7"
    },
    {
      "participant": "auth",
      "start": "m2",
      "end": "m3"
    },
    {
      "participant": "store",
      "start": "m8",
      "end": "m9"
    }
  ]
}
